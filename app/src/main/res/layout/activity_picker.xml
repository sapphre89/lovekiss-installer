<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08132e"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="36dp"
        android:paddingBottom="28dp">

        <ImageView
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_title"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="@string/picker_subtitle"
            android:textAllCaps="true"
            android:textColor="#FFD600"
            android:textSize="13sp"
            android:textStyle="bold" />

        <include
            android:id="@+id/card_firefox"
            layout="@layout/item_browser_card" />

        <include
            android:id="@+id/card_yandex"
            layout="@layout/item_browser_card" />

        <include
            android:id="@+id/card_cromite"
            layout="@layout/item_browser_card" />

        <include
            android:id="@+id/card_iceraven"
            layout="@layout/item_browser_card" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/picker_hint"
            android:textColor="#5d6a8a"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
